# DialTone Outreach — Lambda deploy configuration.
#
# Copy this file to ``deploy/config.env`` (gitignored) and fill in the
# values for your AWS account. Every script in ``deploy/`` sources this
# file, so a single edit drives the whole deploy.

# ── AWS account / region ────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012        # `aws sts get-caller-identity --query Account --output text`

# ── Container image / ECR repository ────────────────────────────────
ECR_REPO=dialtone-outreach
IMAGE_TAG=latest

# ── Lambda function ─────────────────────────────────────────────────
LAMBDA_FUNCTION=dialtone-outreach
LAMBDA_ROLE_NAME=dialtone-outreach-lambda-role
LAMBDA_TIMEOUT=600                 # seconds — generous for the daily run loop
LAMBDA_MEMORY=1024                 # MB — pandas + supabase fit comfortably here

# ── EventBridge schedules (cron expressions in UTC) ─────────────────
# Daily run: 14:00 UTC = 9 AM Central (CDT) / 8 AM Central (CST). Adjust
# seasonally or use a fixed-offset zone if DST shifts matter.
# NOTE: keep the quotes — these values contain ``( )`` which bash treats
# as syntax when sourcing this file unquoted.
DAILY_RUN_SCHEDULE="cron(0 14 ? * MON-FRI *)"
# Reply check: every 30 minutes covers the M3 5-min SLA at 1/6th the
# invocation count. Drop to ``rate(5 minutes)`` for the strict SLA.
REPLY_CHECK_SCHEDULE="rate(30 minutes)"

# ── SES bounce / complaint alarms ───────────────────────────────────
ALERT_EMAIL=ops@example.com        # subscribed to the SNS alarm topic
SNS_TOPIC_NAME=dialtone-outreach-ses-alerts
# AWS suspends sending at 10% / 0.5%. Alarm well below those.
BOUNCE_RATE_THRESHOLD=0.05         # 5%
COMPLAINT_RATE_THRESHOLD=0.001     # 0.1%
